{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "env": {
    "MODEL_STORAGE_URL": "https://raw.githubusercontent.com/maddurvignesh/phishguard-ai/main/models/phishguard_model.joblib",
    "META_STORAGE_URL": "https://raw.githubusercontent.com/maddurvignesh/phishguard-ai/main/models/model_meta.json",
    "RESULTS_STORAGE_URL": "https://raw.githubusercontent.com/maddurvignesh/phishguard-ai/main/ml/evaluation/model_results.json"
  }
}
